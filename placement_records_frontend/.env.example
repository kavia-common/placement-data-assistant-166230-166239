# Public env variables for React app (Create React App)
# Copy this file to .env and adjust for your environment.

# PUBLIC_INTERFACE
# REACT_APP_BACKEND_URL defines the base URL used by the frontend to contact the FastAPI backend.
# It can be:
# - Absolute: e.g., https://your-hostname:3001
# - Relative: e.g., /api  (when a reverse proxy maps /api -> backend)
REACT_APP_BACKEND_URL=https://localhost:3001
